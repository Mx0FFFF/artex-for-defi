# Docker 部署配置（复制为 .env）
POSTGRES_USER=artex
# Set a unique password before starting Compose.
POSTGRES_PASSWORD=
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 可选：DeFi 只读固定区块查询使用。固定工具要求 HTTPS（不可带 URL 用户名/密码），
# 且响应的 chain ID 必须与任务范围一致。手动 fork 仍仅作探索。
RPC_URL=
